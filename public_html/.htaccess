# 818 Digital Agency — Apache/LiteSpeed rules (cPanel / 20i)
Options -Indexes
DirectoryIndex index.php

# PHP version is chosen in the hosting panel (PHP 8.2 or newer). Do not force a handler here.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# Never serve data, secrets, backups, logs or dotfiles from the web root.
<FilesMatch "(^\.|\.(log|sql|gz|sqlite|env|md|lock|bak|ini)$|^(config|overrides|email-log|nx818_cms_content|composer|package)\.json$)">
  Require all denied
</FilesMatch>

RewriteEngine On
# Old client-docs folder (public PDFs) is retired — documents are served by the app after an ownership check.
RewriteRule ^client-docs/ - [F,L]
RewriteRule ^(_app|private)/ - [F,L]

# Static assets that exist on disk are served directly.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} \.(css|js|png|jpe?g|gif|svg|webp|mp4|ico|woff2?|ttf|eot|txt)$ [NC]
RewriteRule ^ - [L]

# Hardened legacy API endpoints (admin-only, see api/_guard.php) are real files.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} ^/api/[a-z0-9\-]+\.php$ [NC]
RewriteRule ^ - [L]

# One-time installer (switches itself off after use).
RewriteRule ^install\.php$ - [L]

# Everything else goes to the front controller (including /sitemap.xml, /robots.txt, /llms.txt).
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteRule ^ /index.php [L,QSA]

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|ttf|svg|png|jpe?g|webp|mp4|ico)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain image/svg+xml application/xml
</IfModule>
