{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public_html",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 60,
      "includeFiles": "{app/**,public_html/index.php,public_html/api/**}",
      "excludeFiles": "{app/storage/**,app/.env,tests/**,docs/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/api/resend-webhook\\.php",
      "dest": "/api/resend-webhook.php"
    },
    {
      "src": "^/(.*/)?$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)\\.(php|htaccess|txt\\.example)$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(assets|fonts|media)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=2592000"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/cron",
      "schedule": "0 9 * * *"
    }
  ]
}