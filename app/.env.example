# 818 Digital Agency — environment configuration. Copy to app/.env (outside public_html). Never commit the real file.
APP_URL=https://818digitalagency.com
APP_DEBUG=false
# Generated by bin/setup.php. Encrypts stored integration secrets — back it up; losing it means re-entering API keys.
APP_KEY=

# MySQL (cPanel → MySQL Databases). Leave DB_NAME empty to use SQLite in app/storage (development only).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

SESSION_SECURE=true
# auto = Resend if configured, else PHP mail(); log = write to log only (testing)
MAIL_DRIVER=auto
MAIL_FROM=hello@818nexus.ca

# Optional: put API keys here instead of Admin → Integrations (env always wins).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TWENTYI_API_KEY=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
NX818_EMAIL_PASS=
# Optional malware scanning of uploads, e.g. /usr/bin/clamscan
CLAMSCAN_PATH=
